{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|compact|clear",
      "hooks": [{
        "type": "command",
        "command": "python3 \"${PLUGIN_ROOT}/hooks/mode.py\"",
        "commandWindows": "python \"${PLUGIN_ROOT}/hooks/mode.py\"",
        "timeout": 5,
        "additionalContextLimit": 1500
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "python3 \"${PLUGIN_ROOT}/hooks/mode.py\"",
        "commandWindows": "python \"${PLUGIN_ROOT}/hooks/mode.py\"",
        "timeout": 5,
        "additionalContextLimit": 1500
      }]
    }]
  }
}
